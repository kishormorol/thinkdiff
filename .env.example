# Copy this file to .env.local and fill in the keys you need.
# Every key is optional — set only the providers you want to compare.

# Anthropic — Claude Sonnet 4, and also required for trace parsing (Claude Haiku)
ANTHROPIC_API_KEY=

# DeepSeek — DeepSeek R1
DEEPSEEK_API_KEY=

# OpenAI — o3-mini
OPENAI_API_KEY=
